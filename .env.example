# Server
NODE_ENV=development
PORT=3000

# Database
# For MongoDB transactions, run MongoDB as a single-node replica set
# and include ?replicaSet=rs0 in the URI.
#
# Development/demo uses the "recoverai" database.
# Tests automatically derive a "_test" suffixed database from this URI
# (e.g. mongodb://127.0.0.1:27017/recoverai_test) so test runs never
# touch the real demo database.
MONGODB_URI=mongodb://127.0.0.1:27017/recoverai?replicaSet=rs0

# Razorpay TEST MODE only
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Razorpay Dashboard > Account & Settings > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Merchant-admin session signing secret
# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=12h

# Deployment only: comma-separated browser origins
# Example:
# CORS_ORIGIN=https://your-frontend.netlify.app
CORS_ORIGIN=

# AI-assisted recovery recommendation stage
# Optional. If unset, deterministic fallback provider is used.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=8000