# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/recoverai

# Razorpay TEST MODE only. Leave unset until the Razorpay adapter is enabled.
RAZORPAY_KEY_ID=rzp_test_TTaVqUprHXogjV
RAZORPAY_KEY_SECRET=8onl69zDJyKWldcOS6QjNt2L
# Razorpay webhook payload account_id for this TEST account (non-secret).
# RAZORPAY_ACCOUNT_ID=

# Razorpay Dashboard > Account & Settings > Webhooks > Secret.
# This is independent of the API key secret and is required to receive webhooks.
RAZORPAY_WEBHOOK_SECRET=5Zn8_E4sEWKX8@6

# Signs merchant-admin session tokens issued by POST /api/auth/login.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h

# Deployment only: comma-separated browser origins allowed to call this API
# from a deployed frontend (e.g. https://<site>.netlify.app). Leave unset for
# local development; the Vite proxy keeps everything same-origin.
CORS_ORIGIN=

# AI-assisted recovery recommendation stage. Fully optional: when unset, the
# application uses the deterministic fallback provider only and never makes
# an outbound AI call. "anthropic" is currently the only supported value for
# AI_PROVIDER; an unsupported value fails safely into the fallback path.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=8000
